      <data key="d2">chunk-74e2466de2f67fd710ef2f20c0a8d9e0</data>
    </node>
    <node id="&quot;SCROOGE'S CLERK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Scrooge's Clerk works in a dismal cell, indicative of his lowly status and Scrooge's miserly nature; has to make do with very little warmth."</data>
      <data key="d2">chunk-74e2466de2f67fd710ef2f20c0a8d9e0</data>
    </node>
    <node id="&quot;THE COURT&quot;">
