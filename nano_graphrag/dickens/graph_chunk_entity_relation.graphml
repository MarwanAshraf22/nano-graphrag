      <data key="d3">[{"level": 0, "cluster": 4}]</data>
    </node>
    <node id="&quot;THE TREADMILL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Treadmill is a form of hard labor that is part of the system used to manage the poor, referenced as being in full vigor."</data>
      <data key="d2">chunk-90d5764e301321c087f5a8f78b73a145</data>
