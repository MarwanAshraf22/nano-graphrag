      <data key="d1">"The Warning is the message delivered by Jacob Marley's Ghost to Scrooge, notifying him of the impending visits by the Three Spirits."</data>
      <data key="d2">chunk-44d647b83223cc8b53863d27ac7cc4bf</data>
    </node>
